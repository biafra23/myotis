# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android — local SDK path, per-dev only
local.properties

# Compiled class files
*.class

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/

# macOS
.DS_Store
._*

# Node key (contains private key) — mainnet and per-network (nodekey-<net>.hex)
nodekey.hex
nodekey-*.hex
app/peers.cache
*.cache
# Persisted light-client sync snapshots (per-network runtime state) + their .roots accumulators
*.snapshot
*.snapshot.roots
app/devp2p.log
app/devlibp2p.log
.gradle-home/
app/cacheDir/

# Kotlin incremental-compile scratch + ad-hoc daemon logs
.kotlin/
*.log

# Xcode (ios-app) — per-user state; the generated .xcodeproj itself is committed
xcuserdata/
*.xcworkspace/xcuserdata/
ios-app/DerivedData/

# Rust native libs for Android (the Rust engine + native BLS) are BUILT FROM
# SOURCE by the Android build (cargoNdkAndroid), not committed — a committed
# binary would drift from the Rust source and silently ship a dead engine.
# `-PskipRustEngine` omits them (the app falls back to the Java engine).
/android-app/src/main/jniLibs/*/libmyotis_*.so
logindex-*.db
