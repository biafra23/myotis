# Pins that exist only for the builder image (#734, Part 5b). Sourced by
# docker/builder/build.sh, which passes them to the Dockerfile as build args.
#
# The versions the BUILD itself pins are not repeated here. build.sh reads them
# from their one source each:
#   JDK version       .java-version
#   rustc             rust/rust-toolchain.toml (channel)
#   NDK, build-tools  gradle/libs.versions.toml (android-ndk, android-build-tools)
#   cargo-ndk         gradle/libs.versions.toml (cargo-ndk)
# Bumping one of those needs the matching line below moved in the same change
# where there is one (JDK_*: a new JDK version has a new build number and
# hash); build.sh refuses a mismatch instead of building a mixed image.

# The base image, by digest: `ubuntu:26.04` as of 2026-10-29, the release the
# CI runners (ubuntu-26.04) run. A tag alone is a moving target.
BASE_IMAGE=ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

# Every apt package comes from the archive AS OF this instant
# (snapshot.ubuntu.com), so the package set does not move with the day the
# image is built.
APT_SNAPSHOT=20261029T000000Z

# Eclipse Temurin, the distribution CI's setup-java installs. JDK_VERSION must
# equal .java-version; the build number and hash belong to that exact release
# (https://github.com/adoptium/temurin21-binaries/releases).
JDK_VERSION=21.0.13
JDK_BUILD=9
JDK_SHA256=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c

# rustup-init (x86_64-unknown-linux-gnu), which installs the pinned rustc.
# https://static.rust-lang.org/rustup/archive/<version>/x86_64-unknown-linux-gnu/rustup-init.sha256
RUSTUP_VERSION=1.29.3
RUSTUP_SHA256=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55

# Android command-line tools 23.0 (sdkmanager). Google's repository manifest
# publishes only a SHA-1 (e025545c62a8e64c7559119566a569fb1dec5f60); the
# SHA-256 is of the same file, checked against it on 2026-11-10.
ANDROID_CMDLINE_TOOLS=16111833
ANDROID_CMDLINE_TOOLS_SHA256=0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8

# compileSdk (android-app and myotis-engine build files); build.sh checks it.
ANDROID_PLATFORM=35
